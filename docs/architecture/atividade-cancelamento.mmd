        C3["Liberar o horário e<br/>promover a próxima da fila"]:::acao
        C4["Notificar os envolvidos<br/>por e-mail (RF25)"]:::acao
    end

    FIM1(("fim")):::inicio
    FIM2(("fim")):::inicio

    INI --> C1 --> D1
