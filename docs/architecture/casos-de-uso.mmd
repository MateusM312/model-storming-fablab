@startuml FabLab_Casos_de_Uso
left to right direction
skinparam packageStyle rectangle

actor "Solicitante" as SOL
actor "Admin / Técnico" as ADM
actor "Financeiro" as FIN
actor "Fornecedor" as FOR

rectangle "FabLab" {

  ' --- Reservas ---
  usecase "Reservar Máquina" as UC1
  usecase "Consultar Disponibilidade" as UC2
  usecase "Consultar posição na fila" as UC3
  usecase "Cancelar Reserva" as UC4
  usecase "Aprovar reserva" as UC5
  usecase "Negar Reserva" as UC6
  usecase "Gerenciar Fila de prioridade" as UC7

  ' --- Máquinas ---
  usecase "Cadastrar/atualizar máquina" as UC8
  usecase "Marcar máquina em manutenção" as UC9

  ' --- Insumos ---
  usecase "Registrar uso de insumo" as UC10
  usecase "Controlar estoque de insumo" as UC11
  usecase "Solicitar compra de insumo" as UC12

  ' --- Compras ---
  usecase "Aprovar compra de insumo" as UC13
  usecase "Recusar compra de insumo" as UC14
  usecase "Receber pedido de compra" as UC15
  usecase "Confirmar compra de insumo" as UC16

  ' --- Comum ---
  usecase "Justificativa" as UC17
}

' Solicitante
SOL --> UC1
SOL --> UC2
SOL --> UC3
SOL --> UC4
SOL --> UC10

' Admin / Técnico
ADM --> UC5
ADM --> UC6
ADM --> UC7
ADM --> UC8
ADM --> UC9
ADM --> UC11
ADM --> UC12

' Financeiro
FIN --> UC13
FIN --> UC14

' Fornecedor
FOR --> UC15
FOR --> UC16

' Relacionamentos entre casos de uso
UC1 ..> UC2 : <<include>>
UC6 ..> UC17 : <<include>>
UC14 ..> UC17 : <<include>>

@enduml