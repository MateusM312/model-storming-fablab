classDiagram
    direction LR

    class Usuario {
        +id : int
        +nome : string
        +email : string
        +perfil : PerfilUsuario
    }

    class Maquina {
        +id : int
        +nome : string
        +tipo : string
        +estado : EstadoMaquina
        +motivoManutencao : string
    }

    class Reserva {
        +id : int
        +dataInicio : dateTime
        +dataFim : dateTime
        +status : StatusReserva
        +posicaoFila : int
        +justificativa : string
    }

    class Insumo {
        +id : int
        +nome : string
        +unidade : string
        +quantidadeEmEstoque : double
    }

    class ConsumoInsumo {
        +id : int
        +quantidade : double
        +dataRegistro : dateTime
    }

    class PedidoCompra {
        +id : int
        +quantidade : double
        +status : StatusPedido
        +dataSolicitacao : dateTime
        +justificativaRecusa : string
    }

    class PerfilUsuario {
        <<enumeration>>
        SOLICITANTE
        ADMIN_TECNICO
        FINANCEIRO
        FORNECEDOR
    }

    class StatusReserva {
        <<enumeration>>
        PENDENTE
        EM_FILA
        APROVADA
        EM_USO
        CONCLUIDA
        NEGADA
        CANCELADA
    }

    class EstadoMaquina {
        <<enumeration>>
        DISPONIVEL
        RESERVADA
        EM_USO
        EM_MANUTENCAO
    }

    class StatusPedido {
        <<enumeration>>
        SOLICITADO
        APROVADO
        RECUSADO
        ENVIADO_FORNECEDOR
        ENTREGUE
    }

    Usuario "1" --> "*" Reserva : solicita
    Usuario "1" --> "*" PedidoCompra : solicita
    Reserva "*" --> "1" Maquina : aloca
    Reserva "1" --> "*" ConsumoInsumo : gera
    ConsumoInsumo "*" --> "1" Insumo : consome
    PedidoCompra "*" --> "1" Insumo : repõe

    Usuario ..> PerfilUsuario
    Reserva ..> StatusReserva
    Maquina ..> EstadoMaquina
    PedidoCompra ..> StatusPedido
